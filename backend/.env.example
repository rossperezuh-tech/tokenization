# ── Formspree (Source 1: Inbound leads) ──────────────────────────────
FORMSPREE_FORM_ID=your_form_hash_here
FORMSPREE_API_KEY=your_formspree_api_key_here

# ── Resend.com (Outreach emails) ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Twilio (SMS alerts for hot leads) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+1XXXXXXXXXX

# ── Daily digest / weekly report recipient ──────────────────────────
ALERT_EMAIL=you@example.com

# ── Database ─────────────────────────────────────────────────────────
VESTA_DB_PATH=vesta.db

# ── Scraper options ───────────────────────────────────────────────────
# Proxy: STRONGLY recommended for LoopNet (CoStar blocks datacenter IPs).
# Use a residential/rotating proxy. Format: http://user:pass@host:port
SCRAPER_PROXY=

# LoopNet
LOOPNET_HEADLESS=true
LOOPNET_MAX_PAGES=3
# Override to target a different market / filter. Get this URL by running a
# search on loopnet.com and copying the address bar.
LOOPNET_SEARCH_URL=https://www.loopnet.com/search/commercial-real-estate/new-york-ny/for-sale/

# Crexi (API-first; DOM fallback)
CREXI_HEADLESS=true
CREXI_MAX_PAGES=3
# CREXI_API_URL and CREXI_SEARCH_URL can be overridden — see scrapers/crexi.py
# for the defaults and how to capture the real ones from your browser devtools.
CREXI_API_URL=
CREXI_SEARCH_URL=
