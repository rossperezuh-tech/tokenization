# ── Formspree (Source 1: Inbound leads) ──────────────────────────────
FORMSPREE_FORM_ID=your_form_hash_here
FORMSPREE_API_KEY=your_formspree_api_key_here

# ── Resend.com (Outreach emails) ─────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Twilio (SMS alerts for hot leads) ────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+1XXXXXXXXXX

# ── Daily digest / weekly report recipient ──────────────────────────
ALERT_EMAIL=you@example.com

# ── Database ─────────────────────────────────────────────────────────
# Production: set DATABASE_URL to your Postgres connection string (Railway and
# Neon provide it). Leave empty locally to use the SQLite file below.
DATABASE_URL=

# ── Browser access (CORS) ────────────────────────────────────────────
# Comma-separated list of the sites allowed to call this API from a browser.
ALLOWED_ORIGINS=https://vesta-investor.vercel.app,https://vesta-operator.vercel.app

# ── Email sender ─────────────────────────────────────────────────────
# Must be on a domain you have verified in Resend. No default on purpose.
OUTREACH_FROM_EMAIL=
ALERT_FROM_EMAIL=

# Set to false on extra web workers so only one runs the scheduled jobs.
ENABLE_SCHEDULER=true

# ── Operator auth (dashboard + admin API) ────────────────────────────
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=generate-a-long-random-string
JWT_TTL_HOURS=12

# ── Transfer agent / KYC ─────────────────────────────────────────────
# Shared secret your transfer agent uses to call the approval webhook.
TA_WEBHOOK_SECRET=
# OPTIONAL — only if the platform (not the TA) holds the agent key and you want
# the backend to push approvals on-chain automatically. Usually the TA does this.
CHAIN_RPC_URL=
COMPLIANCE_REGISTRY=
AGENT_PRIVATE_KEY=

# ── Database ─────────────────────────────────────────────────────────
VESTA_DB_PATH=vesta.db

# ── Scraper options ───────────────────────────────────────────────────
# Proxy: STRONGLY recommended for LoopNet (CoStar blocks datacenter IPs).
# Use a residential/rotating proxy. Format: http://user:pass@host:port
SCRAPER_PROXY=

# LoopNet
LOOPNET_HEADLESS=true
LOOPNET_MAX_PAGES=3
# Override to target a different market / filter. Get this URL by running a
# search on loopnet.com and copying the address bar.
LOOPNET_SEARCH_URL=https://www.loopnet.com/search/commercial-real-estate/new-york-ny/for-sale/

# Crexi (API-first; DOM fallback)
CREXI_HEADLESS=true
CREXI_MAX_PAGES=3
# CREXI_API_URL and CREXI_SEARCH_URL can be overridden — see scrapers/crexi.py
# for the defaults and how to capture the real ones from your browser devtools.
CREXI_API_URL=
CREXI_SEARCH_URL=

# ── Data room ─────────────────────────────────────────────────────────
VESTA_DOCS_DIR=uploads
