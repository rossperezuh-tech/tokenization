# Deployer wallet (NEVER commit the real key). Use a fresh deploy wallet.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints (defaults to public Base RPCs if unset)
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_RPC=https://mainnet.base.org

# Verify contracts on Basescan (optional)
BASESCAN_API_KEY=

# USDC address. LEAVE EMPTY on testnet/local (a MockUSDC is deployed).
# Base mainnet canonical USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS=

# Offering parameters (used by scripts/deploy.js)
PROP_NAME=182 Atlantic Ave
PROP_SYMBOL=VATL
PROP_TOTAL_TOKENS=100000
PROP_SALE_TOKENS=70000
PROP_ADDRESS=182 Atlantic Ave, Brooklyn, NY 11201
PROP_TYPE=Mixed-Use
PROP_VALUATION_USD=3250000
PROP_PRICE_USDC=32500000
