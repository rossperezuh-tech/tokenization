# thirdweb client ID — get one free at https://thirdweb.com/dashboard
EXPO_PUBLIC_THIRDWEB_CLIENT_ID=

# Which chain the contracts are deployed on: "base" or "base-sepolia"
EXPO_PUBLIC_CHAIN=base-sepolia

# Backend offerings API (the Vesta FastAPI server)
EXPO_PUBLIC_API_URL=http://localhost:8000

# USDC address for the active chain.
# Base mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia / local: the MockUSDC address from your deploy output
EXPO_PUBLIC_USDC_ADDRESS=
